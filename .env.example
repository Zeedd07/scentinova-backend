NODE_ENV=development
PORT=5000

MONGODB_URI=

CLIENT_URL=http://localhost:5173

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

ADMIN_EMAIL=
ADMIN_PASSWORD=

# true on HTTPS (Render). When true and COOKIE_SAMESITE unset, SameSite defaults to none
COOKIE_SECURE=false
# Optional override: lax | none | strict (default: lax locally, none when COOKIE_SECURE=true)
COOKIE_SAMESITE=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_API_KEY=

ORDER_PAYMENT_TTL_MINUTES=30
FREE_SHIPPING_THRESHOLD_PAISE=250000
SHIPPING_PAISE=9900

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

JOB_INTERVAL_MS=60000
